// Editor-only: resolves `@trailblaze/scripting` for `typed.ts` against the repo's SDK bundle, the
// same mapping `../trailmaps/sampleapp/tools/tsconfig.json` gives the trailmap's tools.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@trailblaze/scripting": ["../../../../../sdks/typescript/dist/index"],
      "@trailblaze/scripting/*": ["../../../../../sdks/typescript/dist/*"]
    }
  },
  "include": ["./*.ts"]
}
