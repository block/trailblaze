#!/bin/bash

# Trailblaze launcher
#
# Usage:
#   ./trailblaze app                 - Launch the legacy desktop app
#   ./trailblaze app --v2            - Open Trail Runner in its native desktop window
#   ./trailblaze trailrunner         - Compatibility alias for `app --v2`
#   ./trailblaze stop                - Stop the daemon (kills it if it will not exit on request)
#   ./trailblaze status [--json]     - Show the daemon: PID, uptime, devices, runs; --json for scripts
#   ./trailblaze app --headless      - Start headless daemon
#   ./trailblaze app --stop          - Stop the daemon
#   ./trailblaze blaze "objective"   - Take a UI action (auto-starts daemon)
#   ./trailblaze ask "question"      - Ask about the screen (auto-starts daemon)
#   ./trailblaze run <file>            - Run a trail file (auto-starts daemon)
#   ./trailblaze mcp                 - Start MCP server (STDIO proxy to daemon)
#   ./trailblaze <command>           - Run other CLI commands (config, report, etc.)
#
# Environment variables:
#   TRAILBLAZE_PORT           - HTTP port (default: 52525). Override to run multiple instances.
#   TRAILBLAZE_HTTPS_PORT     - HTTPS port (default: TRAILBLAZE_PORT + 1). Rarely overridden;
#                               derived so a single TRAILBLAZE_PORT override is enough to run
#                               isolated daemons.
#   TRAILBLAZE_JAR            - Path to the uber JAR (default: trailblaze.jar next to this script)
#   TRAILBLAZE_IPC            - Set to 0 to disable the daemon IPC fast path (default: 1).
#                               The fast path requires `jq` on PATH; if jq is missing the CLI
#                               falls back silently to the JVM path. Install jq to benefit.
#
# Logs are saved automatically by the JVM to ~/.trailblaze/desktop-logs/
# (port-specific filenames for parallel instances).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Capture the parent shell PID so the CLI can resolve "what device is pinned
# for this terminal?" from a file in ~/.trailblaze instead of requiring the
# user to wrap `trailblaze device connect` in `eval $(...)` to set
# TRAILBLAZE_DEVICE in their shell. `$PPID` is the wrapper's parent — for
# every interactive invocation that's the shell the user typed into; for
# tmux/screen panes it's the per-pane shell; for CI scripts it's whatever
# spawned this wrapper. Respect any pre-set value so nested invocations
# (one Trailblaze command spawning another via a script) inherit the
# outermost shell's identity rather than overwriting it.
#
# Consumed by `CliCallerContext.callerEnv("TRAILBLAZE_SHELL_PID")` and the
# resolver tier in `CliInfrastructure.resolveDeviceWithAutodetect`. The
# associated file is `~/.trailblaze/shell-device-pins-<port>.json` written
# by `ShellDevicePinStore`.
export TRAILBLAZE_SHELL_PID="${TRAILBLAZE_SHELL_PID:-$PPID}"

# Detect whether this invocation comes from an interactive terminal. `[ -t 0 ]`
# checks if stdin is a tty — true for a human typing commands, false for:
#  - AI agent harnesses (Claude Code Bash tool, Cursor shell, Codex) — each
#    command spawns a fresh shell that doesn't inherit a tty
#  - CI scripts and pipelines (stdin redirected from /dev/null or a file)
#  - Anything with stdin piped from another command
#
# Consumed by the JVM-side `device connect` to decide whether to warn the
# caller that the file-pin won't carry across separate command invocations
# (which it can't if each call is a fresh shell with a different PID). When
# true, no warning — the human is in a real terminal where the pin works.
# When false, the warning fires and steers the caller toward `--device` flags.
#
# Default of `0` (assume non-interactive) is the safer fallback: a missed
# warning to a real human is mild noise; a missed warning to an agent is a
# loop. Respects any pre-set value so a future tool that wants to override
# the detection can.
if [ -z "${TRAILBLAZE_INTERACTIVE:-}" ]; then
  if [ -t 0 ]; then
    export TRAILBLAZE_INTERACTIVE=1
  else
    export TRAILBLAZE_INTERACTIVE=0
  fi
fi

# Respect JAVA_HOME (required by homebrew)
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_BIN="$JAVA_HOME/bin/java"
else
  JAVA_BIN="java"
fi

# Compose touches AppKit before entering its server-only branch on macOS. Force AWT headless for
# every headless entrypoint, including the launcher embedded in distribution JARs. JAVA_TOOL_OPTIONS
# also reaches a Gradle-forked app JVM, unlike a JVM flag passed only to Gradle itself.
for tb_arg in "$@"; do
  if [ "$tb_arg" = "--headless" ]; then
    export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Djava.awt.headless=true"
    break
  fi
done

# ---------------------------------------------------------------------------
# JDK version check (lazy)
# ---------------------------------------------------------------------------
#
# A daemon-forwarded command never starts Java in this process, so probing `java -version`
# before the IPC decision was pure hot-path overhead. JVM fallbacks call this immediately
# before their first tb_run* invocation; the guard keeps auto-start + command execution from
# probing twice in one wrapper process.
tb_check_java_version() {
  [ "${TB_JAVA_VERSION_CHECKED:-0}" = "1" ] && return 0
  TB_JAVA_VERSION_CHECKED=1
  # A wrapper around this launcher may pin a particular JDK, and working out which one costs a JVM
  # probe of its own. Called from here — the one point every JVM launch passes through, and past the
  # commands this launcher answers itself — so asking for usage never pays for it. JAVA_BIN was
  # resolved at load time, before that JAVA_HOME existed, so re-resolve it against the pinned one.
  if declare -f tb_pin_java > /dev/null 2>&1; then
    tb_pin_java
    if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
      JAVA_BIN="$JAVA_HOME/bin/java"
    fi
  fi
  local java_version
  java_version=$("$JAVA_BIN" -version 2>&1 | head -1 | sed -E 's/.*"([0-9]+).*/\1/')
  if [ -n "$java_version" ] && [ "$java_version" -lt 17 ] 2>/dev/null; then
    echo "ERROR: Trailblaze requires JDK 17 or later, but found JDK ${java_version}." >&2
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Port configuration
# ---------------------------------------------------------------------------

TRAILBLAZE_DEFAULT_PORT=52525
TRAILBLAZE_PORT="${TRAILBLAZE_PORT:-$TRAILBLAZE_DEFAULT_PORT}"
# HTTPS defaults to TRAILBLAZE_PORT + 1 so a single port override is enough to
# run multiple daemons in isolation. Mirrors TrailblazeDevicePort's Kotlin-side
# convention (the on-device RPC server defaults to TRAILBLAZE_PORT + 2).
TRAILBLAZE_HTTPS_PORT="${TRAILBLAZE_HTTPS_PORT:-$((TRAILBLAZE_PORT + 1))}"

# Export so the JVM process can read them via System.getenv()
export TRAILBLAZE_PORT
export TRAILBLAZE_HTTPS_PORT

# Ports Trailblaze allocates to devices. Mirrors PORT_RANGE_START and PORT_RANGE_SIZE in
# TrailblazeDevicePort.kt; a port-range test fails if they drift apart.
TRAILBLAZE_DEVICE_PORT_RANGE_START=52530
TRAILBLAZE_DEVICE_PORT_RANGE_END=59529

# Refuse a daemon port a device could be allocated, before this script probes /ping.
#
# The JVM refuses one too, but it never gets the chance: the host bridges a device with
# `adb forward tcp:<port> tcp:<port>`, so the device answers this script's probe, the daemon is
# never spawned, and the script goes on to send workspace requests and open Trail Runner against
# the device's RPC server. Callers that act on an already-running daemon (`stop`, `status`) skip
# this — one started before the check existed still has to be stoppable.
require_usable_daemon_port() {
    local port
    for port in "$TRAILBLAZE_PORT" "$TRAILBLAZE_HTTPS_PORT"; do
        if [ "$port" -ge "$TRAILBLAZE_DEVICE_PORT_RANGE_START" ] 2>/dev/null &&
            [ "$port" -le "$TRAILBLAZE_DEVICE_PORT_RANGE_END" ] 2>/dev/null; then
            echo "ERROR: port $port is inside the range Trailblaze allocates device ports from" >&2
            echo "       (${TRAILBLAZE_DEVICE_PORT_RANGE_START}-${TRAILBLAZE_DEVICE_PORT_RANGE_END})." \
                "A connected device can be assigned it, and \`adb forward\`" >&2
            echo "       would take it from the daemon without reporting an error." >&2
            echo "       Set TRAILBLAZE_PORT below $((TRAILBLAZE_DEVICE_PORT_RANGE_START - 1))," \
                "or change serverPort in trailblaze-settings.json" >&2
            echo "       (a saved port outranks the env var). The HTTPS port derives as +1." >&2
            exit 1
        fi
    done
}

# ---------------------------------------------------------------------------
# Help for the commands the launcher answers itself
# ---------------------------------------------------------------------------
#
# `stop` and `status` never reach the JVM, so nothing else can answer `--help` for them: before
# this existed, `trailblaze stop --help` stopped the daemon, because the dispatch that owns those
# words reads `$1` and never looks at what follows it. `mcp` and `trailrunner` do reach a JVM, but
# only after the launcher has acted: `mcp` auto-starts the daemon before the JVM can print anything,
# and `trailrunner` is a launcher alias the JVM does not know, so its `--help` was a picocli error.
#
# `app` is not here on purpose. Its flags (`--headless`, `--stop`, `--v2`) are picocli options the
# JVM owns, and `trailblaze app --help` reaches it without starting a daemon.
#
# Answered up here, ahead of every JVM-touching block, because printing usage has to cost nothing.
# Below this point the launcher would first build the AppCDS archive — three JVM launches and a
# "preparing for first use" notice — and an unrelated bad TRAILBLAZE_IO_PARALLELISM would exit
# before the text ever appeared.
launcher_command_help_requested() {
    local arg
    shift
    for arg in "$@"; do
        case "$arg" in -h | --help) return 0 ;; esac
    done
    return 1
}

# Usage for one launcher-answered command. Returns non-zero for anything else, so a `--help` meant
# for the JVM (`trailblaze run x --help`) falls through to the normal dispatch instead of being
# answered with silence.
print_launcher_command_help() {
    case "${1:-}" in
        stop)
            cat <<EOF
Usage: trailblaze stop

Stop the Trailblaze daemon on port ${TRAILBLAZE_PORT} (set TRAILBLAZE_PORT to pick another).
Asks it to exit, then ends its process if it will not, including a wedged daemon that holds the
port without answering. Exits 0 when nothing is running.
EOF
            ;;
        status)
            cat <<EOF
Usage: trailblaze status [--json]

Show the Trailblaze daemon on port ${TRAILBLAZE_PORT} (set TRAILBLAZE_PORT to pick another):
PID, uptime, version, connected devices, active runs, workspace, and log path.
  --json   Print the daemon's status object for scripts; still JSON when nothing is running.
EOF
            ;;
        mcp)
            cat <<EOF
Usage: trailblaze mcp [--http] [--direct | --no-daemon] [-d <device>] [-t <target>]

Start a Model Context Protocol (MCP) server so an AI coding agent can drive Trailblaze.
By default it speaks STDIO and proxies to the Trailblaze daemon on port ${TRAILBLAZE_PORT},
starting one if none is running (set TRAILBLAZE_PORT to pick another port, or
TRAILBLAZE_DISABLE_DAEMON_AUTOSTART=1 to never start one).
  --http                  Serve Streamable HTTP as a standalone MCP server instead of STDIO.
  --direct, --no-daemon   Run the MCP server in this process over STDIO instead of proxying to a
                          separate daemon process. Not a way around the HTTP port: this process
                          still starts the daemon's HTTP server itself when none is running.
  -d, --device <device>   Pin this session to a device on startup (e.g. android,
                          android/emulator-5554). Defaults to the device this terminal pinned
                          with \`trailblaze device connect\`, or \$TRAILBLAZE_DEVICE.
  -t, --target <target>   Pin this session to a target app on startup (e.g. default, sampleapp).
                          Only meaningful with a device. Defaults to \$TRAILBLAZE_TARGET.

Quick setup:
  Claude Code:  claude mcp add trailblaze -- trailblaze mcp
  Cursor:       Add to .cursor/mcp.json with command 'trailblaze mcp'
  Windsurf:     Add to MCP config with command 'trailblaze mcp'
EOF
            ;;
        trailrunner)
            cat <<EOF
Usage: trailblaze trailrunner

Open Trail Runner in its native desktop window; the same as \`trailblaze app --v2\`. Starts the
Trailblaze daemon on port ${TRAILBLAZE_PORT} if none is running (set TRAILBLAZE_PORT to pick
another), makes the git repository containing the current directory the active workspace, then
opens http://localhost:${TRAILBLAZE_PORT}/trailrunner/ — on macOS in a native shell compiled with
Xcode's command-line tools, elsewhere through xdg-open. Takes no options.
EOF
            ;;
        *) return 1 ;;
    esac
}

if launcher_command_help_requested "$@" && print_launcher_command_help "${1:-}"; then
    exit 0
fi

# `trailrunner` takes no options, and the JVM does not know the word: anything after it used to fall
# through to a picocli "Unknown command 'trailrunner'", a diagnosis of the wrong token. Refused here,
# before anything costs a JVM, with the same exit status picocli gives a usage error.
if [ "${1:-}" = "trailrunner" ] && [ $# -gt 1 ]; then
    # Every extra token, not just the first: a reader who passed three needs to see all three to
    # know which one they have to drop.
    printf "ERROR: 'trailblaze trailrunner' takes no arguments; got: %s\n" "${*:2}" >&2
    printf "Run 'trailblaze trailrunner --help' for usage.\n" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

# JVM args required for Compose Desktop on macOS — Skiko's JNI native code needs
# access to internal AWT classes. Without these, java -jar crashes with SIGSEGV.
# Default max heap covers report generation with large session logs.
# TRAILBLAZE_MAX_HEAP overrides (e.g. TRAILBLAZE_MAX_HEAP=8g for very large workspaces).
TRAILBLAZE_JVM_ARGS="-Xmx${TRAILBLAZE_MAX_HEAP:-4g}"

# Dispatchers.IO parallelism. Every scripted-tool subprocess holds one IO permit for its whole
# session: the MCP SDK reads the subprocess's stdout with a blocking read and hardcodes
# Dispatchers.IO for it, so the permit is parked from handshake to shutdown. Inline tools are one
# subprocess per author file, so a target with 64 tool files exhausts the 64-permit default — and
# an exhausted IO pool does not fail, it hangs every daemon route while /ping keeps answering 200
# (it is served on the Netty event loop and needs no permit).
#
# Set here rather than in Kotlin because kotlinx.coroutines reads this property once, the first
# time Dispatchers.IO is touched; a System.setProperty after that point is a silent no-op.
# Permits are lazy — threads materialize only as they are used — so a high ceiling costs nothing
# when unused.
#
# Validated here because kotlinx accepts only an integer in 1..2147483647 and calls error() on
# anything else, killing the JVM the first time Dispatchers.IO is touched — with a message naming
# the system property, not the environment variable someone actually mistyped. The upper bound is
# part of the contract: kotlinx range-checks against Int.MAX_VALUE, so a value above it is as fatal
# as a letter.
# SISTER-IMPL-TAG: io-parallelism-default. The 512 below must stay in lockstep with every other
# site carrying that tag — grep for it; the launcher contract test pins them together.
if [[ -n "${TRAILBLAZE_IO_PARALLELISM:-}" ]]; then
  if ! [[ "$TRAILBLAZE_IO_PARALLELISM" =~ ^[1-9][0-9]*$ ]] \
      || [ "${#TRAILBLAZE_IO_PARALLELISM}" -gt 10 ] \
      || [ "$TRAILBLAZE_IO_PARALLELISM" -gt 2147483647 ]; then
    echo "trailblaze: TRAILBLAZE_IO_PARALLELISM must be an integer between 1 and 2147483647, got '$TRAILBLAZE_IO_PARALLELISM'" >&2
    exit 1
  fi
  # Accepted, but it cannot do what the operator wants: the host holds 16 permits back for its own
  # adb, file and HTTP work, so at or below that every scripted-tool launch is refused. Warn rather
  # than fail — a value this low is valid for a run with no scripted tools at all.
  if [ "$TRAILBLAZE_IO_PARALLELISM" -le 16 ]; then
    echo "trailblaze: TRAILBLAZE_IO_PARALLELISM=$TRAILBLAZE_IO_PARALLELISM leaves no room for scripted-tool subprocesses (16 permits are reserved for the host), so any target with scripted tools will fail to start." >&2
  fi
fi
TRAILBLAZE_JVM_ARGS="$TRAILBLAZE_JVM_ARGS -Dkotlinx.coroutines.io.parallelism=${TRAILBLAZE_IO_PARALLELISM:-512}"

if [[ "$(uname)" == "Darwin" ]]; then
  TRAILBLAZE_JVM_ARGS="$TRAILBLAZE_JVM_ARGS --add-opens java.desktop/sun.awt=ALL-UNNAMED --add-opens java.desktop/sun.lwawt=ALL-UNNAMED --add-opens java.desktop/sun.lwawt.macosx=ALL-UNNAMED"
fi

TRAILBLAZE_JAR="${TRAILBLAZE_JAR:-$SCRIPT_DIR/trailblaze.jar}"

# ---------------------------------------------------------------------------
# AppCDS — class data sharing archive for faster JVM startup
# ---------------------------------------------------------------------------
# Generates a .jsa sibling to the JAR on first use, then passes
# -XX:SharedArchiveFile=<path> -Xshare:auto on every subsequent invocation.
#
# Why static CDS (-Xshare:dump) and not dynamic CDS (-XX:ArchiveClassesAtExit):
# dynamic CDS requires a pre-existing base archive (Temurin's default classes.jsa),
# which is NOT shipped in the Temurin 17 macOS build — the JVM fails with
# "DynamicDumpSharedSpaces is unsupported when base CDS archive is not loaded".
# Static CDS builds a standalone archive from a class list with no base needed.
#
# Why a sibling file and not a JAR entry: CDS binds the archive to the exact
# JAR contents (size + mtime) at dump time. Adding the .jsa as a JAR entry
# changes the JAR's fingerprint and makes the archive unusable ("A jar file
# is not the one used while building the shared archive file"). Keeping the
# .jsa outside the JAR preserves the fingerprint.
#
# -Xshare:auto (not :on) means fingerprint mismatches — JVM version skew,
# replaced JAR — silently fall back to standard class loading. Pure upside.
#
# Escape hatch: set BLAZE_CDS=0 to disable. Regenerated automatically when
# the JAR is newer than the .jsa (e.g., after a dev rebuild).

tb_ensure_cds_archive() {
  local jar="$1"
  # The CDS archive path gets injected into unquoted $TRAILBLAZE_JVM_ARGS (same
  # pattern as --add-opens). Bail if the JAR path contains whitespace so we
  # don't word-split the JVM arg and break startup; plain JAR mode still works.
  case "$jar" in *[[:space:]]*) return 1 ;; esac

  local jsa="${jar%.jar}.jsa"

  if [ -f "$jsa" ] && [ ! "$jar" -nt "$jsa" ]; then
    printf '%s' "$jsa"
    return 0
  fi
  [ -w "$(dirname "$jsa")" ] || return 1

  local classlist tmp_jsa
  classlist="$(mktemp "${TMPDIR:-/tmp}/trailblaze-classlist.XXXXXX")" || return 1
  tmp_jsa="${jsa}.tmp.$$"

  # Three JVM launches follow before the user's command runs — a silent pause long enough
  # to look like a hang on a fresh install or right after an upgrade. Say so once, on stderr
  # so a captured stdout (`out=$(trailblaze config show)`) stays clean.
  echo "Preparing Trailblaze for first use after install (one-time)..." >&2

  # Class list is dumped from `config show` (not --help) because it exercises
  # CLI parsing + Ktor init for ~60% more coverage without needing a device.
  #
  # After dumping, verify the archive actually loads by running `trail --help`
  # with it. Some JDK 17 builds have a CDS verifier bug with Kotlin enums that
  # manifests as `VerifyError: Bad type on operand stack` when TrailCommand.<init>
  # loads — and that bug is JVM-version-specific, so we need to detect it at
  # generate time rather than pretend it doesn't exist. If the verification
  # command fails, we discard the broken archive and the caller falls back to
  # plain JAR mode for that JAR/JDK combination.
  if "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -XX:DumpLoadedClassList="$classlist" \
         -jar "$jar" config show >/dev/null 2>&1 \
     && "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -XX:SharedClassListFile="$classlist" \
         -XX:SharedArchiveFile="$tmp_jsa" -Xshare:dump \
         -jar "$jar" >/dev/null 2>&1 \
     && "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -XX:SharedArchiveFile="$tmp_jsa" -Xshare:auto \
         -jar "$jar" trail --help >/dev/null 2>&1 \
     && mv -f "$tmp_jsa" "$jsa"; then
    rm -f "$classlist"
    printf '%s' "$jsa"
    return 0
  fi
  rm -f "$classlist" "$tmp_jsa"
  return 1
}

if [ "${BLAZE_CDS:-1}" = "1" ] && [ -f "$TRAILBLAZE_JAR" ]; then
  TRAILBLAZE_CDS_ARCHIVE="$(tb_ensure_cds_archive "$TRAILBLAZE_JAR")"
  if [ -n "$TRAILBLAZE_CDS_ARCHIVE" ]; then
    TRAILBLAZE_JVM_ARGS="$TRAILBLAZE_JVM_ARGS -XX:SharedArchiveFile=$TRAILBLAZE_CDS_ARCHIVE -Xshare:auto"
  fi
fi

# Roll daemon.log at 50 MB, keeping one generation. The JVM only applies that rule when it opens
# the file itself; a launcher-started daemon inherits the redirect below instead, so on that path
# nothing capped the file and it grew without bound.
#
# SISTER-IMPL-TAG: daemon-log-roll-bytes. The size and the one-generation rule are duplicated in
# TrailblazeDesktopUtil.DAEMON_LOG_ROLL_BYTES; both write the same file, so they must agree. Grep
# the tag for every site.
TRAILBLAZE_DAEMON_LOG_ROLL_BYTES=$((50 * 1024 * 1024))
tb_roll_daemon_log() {
    local size
    [ -f "$TRAILBLAZE_DAEMON_LOG" ] || return 0
    size=$(wc -c < "$TRAILBLAZE_DAEMON_LOG" 2>/dev/null | tr -d '[:space:]')
    case "$size" in "" | *[!0-9]*) return 0 ;; esac
    [ "$size" -gt "$TRAILBLAZE_DAEMON_LOG_ROLL_BYTES" ] || return 0
    mv -f "$TRAILBLAZE_DAEMON_LOG" "${TRAILBLAZE_DAEMON_LOG}.1" 2>/dev/null || true
}

# Execution functions — overridable by defining them before sourcing this script.
# All functions accept variadic args to preserve quoting (e.g., YAML with newlines).
if ! declare -f tb_run > /dev/null 2>&1; then
  tb_run() {
    "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -jar "$TRAILBLAZE_JAR" "$@"
  }

  # The daemon's output goes to daemon.log, the same file a daemon started from inside the CLI JVM
  # appends to. Discarding it made a daemon that died during startup undiagnosable: all the
  # launcher could report was that the PID it was waiting on had stopped answering.
  tb_run_background() {
    mkdir -p "$(dirname "$TRAILBLAZE_DAEMON_LOG")"
    tb_roll_daemon_log
    nohup "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -jar "$TRAILBLAZE_JAR" "$@" >> "$TRAILBLAZE_DAEMON_LOG" 2>&1 &
  }

  tb_run_quiet() {
    # JAR mode has no build noise, so this is the same as tb_run.
    tb_run "$@"
  }

  tb_run_exec_quiet() {
    exec "$JAVA_BIN" $TRAILBLAZE_JVM_ARGS -jar "$TRAILBLAZE_JAR" "$@"
  }

  tb_run_background_quiet() {
    tb_run_background "$@"
  }
fi

# ---------------------------------------------------------------------------
# Daemon management
# ---------------------------------------------------------------------------

# How long the /ping probe waits for an answer. A daemon that is up answers in
# milliseconds, so anything near this bound means it cannot answer at all.
TRAILBLAZE_PING_TIMEOUT_SECONDS=5

# Bounding the whole request matters as much as bounding the connect: a daemon
# wedged after it bound its port still ACCEPTS the connection, so a probe with
# only --connect-timeout waits forever. Every command starts with this probe,
# and it prints nothing while it waits, so the whole CLI went silent — `trailblaze
# --version` and `trailblaze app start` produced no output at all against a stale
# daemon left listening after an upgrade, and looked like a hung terminal.
#
# A daemon that cannot answer /ping is not a daemon this script can use, so time
# out and report it as down. Say so once, because the alternative is a user who
# sees every command fall back to a fresh JVM and never learns why.
#
# The verdict is remembered for the rest of the command. Whatever holds the port
# still holds it, so no daemon started now can bind it either — and the auto-start
# path polls this up to 60 times, which would turn one 5s stall into a five-minute
# one. Remembering also means the message is printed once.
#
# Deliberately NOT a kill recipe: 5s of silence does not prove the daemon is
# wedged. A daemon mid-trail can block its event loop for longer than that, and
# killing it severs someone else's run — the same hazard the dev launcher's
# /cli/status path fails closed to avoid. Point at the owner instead and let the
# reader decide. Asking that daemon what it is doing is not an option here; a
# daemon that cannot answer /ping cannot answer /cli/status either.
# One probe of the daemon port, with no memory and no advice:
#   0 = answered, 1 = nothing is there, 2 = something holds the port but did not answer.
#
# `stop` asks this directly rather than through [is_daemon_running], for two reasons. The latch
# below makes every probe after the first timeout say "not running", which is the wrong answer for a
# command whose job is to end whatever is on the port — and the advisory below ends with "running in
# its own JVM instead", which is simply untrue of `stop`.
probe_daemon_port() {
    local rc
    curl -s --connect-timeout 1 --max-time "$TRAILBLAZE_PING_TIMEOUT_SECONDS" \
        "http://localhost:${TRAILBLAZE_PORT}/ping" > /dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    # 28 is curl's timeout: the port answered the connect and then went quiet.
    # Anything else (refused, DNS, no route) just means no daemon is there.
    [ "$rc" -eq 28 ] && return 2
    return 1
}

tb_daemon_unresponsive=false
is_daemon_running() {
    [ "$tb_daemon_unresponsive" = true ] && return 1
    local rc
    probe_daemon_port
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    if [ "$rc" -eq 2 ]; then
        tb_daemon_unresponsive=true
        echo "WARNING: whatever is on port ${TRAILBLAZE_PORT} did not answer /ping within" >&2
        echo "         ${TRAILBLAZE_PING_TIMEOUT_SECONDS}s, so this command is running in its own JVM instead." >&2
        echo "         It may be a wedged daemon, or one busy with another run — see who owns" >&2
        echo "         the port before clearing it:  lsof -nP -iTCP:${TRAILBLAZE_PORT} -sTCP:LISTEN" >&2
    fi
    return 1
}

# True once a /ping probe has timed out. Nothing we start can bind a port that is
# already held, so the auto-start paths must neither spawn a daemon for it nor
# poll for one to appear: that poll is 60 one-second sleeps spent waiting for
# something that cannot happen, on top of the probe each iteration used to pay.
daemon_port_held_by_unresponsive() {
    [ "$tb_daemon_unresponsive" = true ]
}

# Daemon auto-start kill-switch. Accepted values mirror the Kotlin side
# (isDaemonAutoStartDisabled in McpProxy.kt): "1" or "true", case-insensitive.
# Both spawn sites in this script honor it, so setting the variable guarantees
# no daemon JVM is launched from any layer.
daemon_autostart_disabled() {
    # tr instead of ${var,,}: macOS ships bash 3.2, which lacks case conversion.
    case "$(printf '%s' "${TRAILBLAZE_DISABLE_DAEMON_AUTOSTART:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true) return 0 ;;
        *) return 1 ;;
    esac
}

# Path to a per-port pidfile recording the JVM PID we spawn for this script.
# Used to detect "JVM is alive but the port is unbound" — i.e. a previous
# auto-start that hung in init before binding HTTP. is_daemon_running() only
# tells us whether the port answers; it can't distinguish "no daemon" from
# "daemon stuck pre-bind", so without this file the next invocation would
# happily spawn another stuck JVM, and another, and another.
TRAILBLAZE_PIDFILE_DIR="${TRAILBLAZE_HOME:-${HOME}/.trailblaze}"
TRAILBLAZE_PIDFILE="${TRAILBLAZE_PIDFILE_DIR}/daemon-${TRAILBLAZE_PORT}.pid"
TRAILBLAZE_START_LOCK="${TRAILBLAZE_PIDFILE}.starting"
# Where every daemon spawn appends its stdout/stderr; rolled at 50 MB (tb_roll_daemon_log here,
# TrailblazeDesktopUtil.getDaemonLogFile in the JVM).
TRAILBLAZE_DAEMON_LOG="${TRAILBLAZE_PIDFILE_DIR}/daemon.log"

# Records the spawned JVM's PID so a subsequent invocation can detect a
# stuck daemon. Called immediately after tb_run_background / tb_run_background_quiet.
record_daemon_pid() {
    mkdir -p "$TRAILBLAZE_PIDFILE_DIR"
    echo "$1" > "$TRAILBLAZE_PIDFILE"
}

process_start_identity() {
    LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# The liveness test for every PID this script tracks. `kill -0` alone is not one:
# it succeeds on a zombie — a process that has exited but whose parent has not
# reaped it — and a zombie cannot be killed, so a daemon left defunct by a
# still-running parent (the desktop app JVM, say) makes every later invocation
# refuse to start a daemon with no remediation but deleting the pidfile by hand.
# `ps -o stat=` is portable across macOS and Linux; its first character is the
# process state, and Z means defunct. An empty status means the process is gone
# or unreadable, which `kill -0` has already ruled on, so only Z overrides it.
#
# Nor is `kill -0` a liveness test for PID 0: it signals the CALLER'S OWN process
# group, which always exists, so a pidfile corrupted to 0 would read as alive on
# every later invocation forever — and `kill` cannot clear that either, for the
# same reason. Only `$!` is ever recorded, and it never writes a zero or a
# leading zero, so any of those means the file is unusable; answering "not alive"
# lets the caller delete it, which is the recovery a user otherwise does by hand.
process_is_alive() {
    case "${1:-}" in '' | 0* | *[!0-9]*) return 1 ;; esac
    kill -0 "$1" 2>/dev/null || return 1
    case "$(LC_ALL=C ps -o stat= -p "$1" 2>/dev/null | sed -e 's/^[[:space:]]*//')" in
        Z*) return 1 ;;
        *) return 0 ;;
    esac
}

read_daemon_startup_owner() {
    local owner_file
    TRAILBLAZE_START_OWNER_FILE=""
    TRAILBLAZE_START_OWNER_PID=""
    TRAILBLAZE_START_OWNER_IDENTITY=""
    for owner_file in "$TRAILBLAZE_START_LOCK"/owner-*; do
        [ -f "$owner_file" ] || continue
        case "$owner_file" in *.new*) continue ;; esac
        TRAILBLAZE_START_OWNER_FILE="$owner_file"
        TRAILBLAZE_START_OWNER_PID=$(sed -n '1p' "$owner_file" 2>/dev/null)
        TRAILBLAZE_START_OWNER_IDENTITY=$(sed -n '2p' "$owner_file" 2>/dev/null)
        return 0
    done
    return 1
}

daemon_startup_owner_alive() {
    [ -n "${TRAILBLAZE_START_OWNER_PID:-}" ] \
        && [ -n "${TRAILBLAZE_START_OWNER_IDENTITY:-}" ] \
        && process_is_alive "$TRAILBLAZE_START_OWNER_PID" \
        && [ "$(process_start_identity "$TRAILBLAZE_START_OWNER_PID")" = "$TRAILBLAZE_START_OWNER_IDENTITY" ]
}

# Atomically elect one starter across Trail Runner and JVM-side Companion launches. The directory
# is the lock. Each generation gets a unique owner filename, so a delayed stale-owner cleanup can
# only delete its own generation, never a replacement created at the same path.
claim_daemon_startup() {
    local prior_pid removed_stale_owner
    mkdir -p "$TRAILBLAZE_PIDFILE_DIR"
    if mkdir "$TRAILBLAZE_START_LOCK" 2>/dev/null; then
        TRAILBLAZE_START_OWNER_FILE="${TRAILBLAZE_START_LOCK}/owner-$$-$(date +%s)-${RANDOM}"
        TRAILBLAZE_START_OWNER_PID="$$"
        TRAILBLAZE_START_OWNER_IDENTITY=$(process_start_identity "$$")
        if [ -z "$TRAILBLAZE_START_OWNER_IDENTITY" ] \
            || ! printf '%s\n%s\n' "$$" "$TRAILBLAZE_START_OWNER_IDENTITY" > "$TRAILBLAZE_START_OWNER_FILE"; then
            rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null || true
            return 2
        fi
        prior_pid=$(cat "$TRAILBLAZE_PIDFILE" 2>/dev/null)
        if [ -n "$prior_pid" ] && process_is_alive "$prior_pid"; then
            rm -f "$TRAILBLAZE_START_OWNER_FILE"
            rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null || true
            printf 'ERROR: a Trailblaze daemon (PID %s) is alive but not responding on port %s.\n' \
                "$prior_pid" "$TRAILBLAZE_PORT" >&2
            printf '       Refusing to start another daemon; stop that process or use another port.\n' >&2
            return 2
        fi
        rm -f "$TRAILBLAZE_PIDFILE"
        return 0
    fi
    if read_daemon_startup_owner && daemon_startup_owner_alive; then
        TRAILBLAZE_EXISTING_START_PID="$TRAILBLAZE_START_OWNER_PID"
        return 1
    fi
    removed_stale_owner=false
    if [ -n "${TRAILBLAZE_START_OWNER_FILE:-}" ] \
        && [ -f "$TRAILBLAZE_START_OWNER_FILE" ] \
        && rm -f "$TRAILBLAZE_START_OWNER_FILE"; then
        removed_stale_owner=true
    else
        # mkdir is the atomic election. A claimant may be between that election and publishing
        # its owner record; do not reclaim this handoff window, which could elect a second daemon.
        # A crashed unpublished claimant is reported as unavailable rather than risking that.
        sleep 1
    fi
    if [ "$removed_stale_owner" = true ] \
        && rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null; then
        claim_daemon_startup
        return $?
    fi
    if read_daemon_startup_owner && daemon_startup_owner_alive; then
        TRAILBLAZE_EXISTING_START_PID="$TRAILBLAZE_START_OWNER_PID"
        return 1
    fi
    printf 'ERROR: could not reclaim daemon startup lock: %s\n' "$TRAILBLAZE_START_LOCK" >&2
    return 2
}

# If a slow source build outlives the caller's wait window, keep one detached watcher responsible
# for removing the claim after that exact process exits. A different daemon could win the port
# while this child remains alive, so HTTP readiness alone must not release its ownership.
reap_daemon_startup_claim() {
    [ "${TRAILBLAZE_DAEMON_START_OWNER:-false}" = true ] || return 0
    nohup bash -c '
      pid="$1"; owner="$2"; started="$3"; lock="$4"
      process_identity() {
        LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//"
      }
      # Same rules as process_is_alive in the parent script, and for the same reason:
      # a defunct daemon still answers kill -0 and still reports its start time, and
      # kill -0 0 signals the process group of the watcher itself, so without both the
      # watcher spins forever and never releases the claim it exists to release.
      process_alive() {
        case "${1:-}" in "" | 0* | *[!0-9]*) return 1 ;; esac
        kill -0 "$1" 2>/dev/null || return 1
        case "$(LC_ALL=C ps -o stat= -p "$1" 2>/dev/null | sed -e "s/^[[:space:]]*//")" in
          Z*) return 1 ;;
          *) return 0 ;;
        esac
      }
      while process_alive "$pid" && [ "$(process_identity "$pid")" = "$started" ]; do
        sleep 5
      done
      if [ -f "$owner" ] && rm -f "$owner"; then
        rmdir "$lock" 2>/dev/null || true
      fi
    ' _ "$TRAILBLAZE_DAEMON_START_PID" "$TRAILBLAZE_START_OWNER_FILE" \
      "$TRAILBLAZE_START_OWNER_IDENTITY" "$TRAILBLAZE_START_LOCK" \
      >/dev/null 2>&1 &
    TRAILBLAZE_DAEMON_START_REAPER_PID="$!"
}

# Starts or joins the one daemon startup allowed for this port. Results are returned in globals so
# callers can retain their existing progress messages and wait policies. The lock is replaced
# atomically with the spawned JVM PID; another process may observe the launcher's PID before that
# handoff, but both remain live throughout startup.
start_daemon_background() {
    local output_mode="${1:-normal}"
    local claim_exit lock_tmp
    TRAILBLAZE_DAEMON_START_OWNER=false
    TRAILBLAZE_DAEMON_START_PID=""
    TRAILBLAZE_DAEMON_START_REAPER_PID=""
    TRAILBLAZE_EXISTING_START_PID=""
    TRAILBLAZE_START_OWNER_FILE=""
    TRAILBLAZE_START_OWNER_PID=""
    TRAILBLAZE_START_OWNER_IDENTITY=""

    if claim_daemon_startup; then
        TRAILBLAZE_DAEMON_START_OWNER=true
        if [ "$output_mode" = "quiet" ]; then
            tb_run_background_quiet app --foreground --headless
        else
            tb_run_background app --foreground --headless
        fi
        TRAILBLAZE_DAEMON_START_PID="$!"
        record_daemon_pid "$TRAILBLAZE_DAEMON_START_PID"
        TRAILBLAZE_START_OWNER_PID="$TRAILBLAZE_DAEMON_START_PID"
        TRAILBLAZE_START_OWNER_IDENTITY=$(process_start_identity "$TRAILBLAZE_DAEMON_START_PID")
        lock_tmp="${TRAILBLAZE_START_OWNER_FILE}.new.$$"
        if [ -z "$TRAILBLAZE_START_OWNER_IDENTITY" ] \
            || ! printf '%s\n%s\n' "$TRAILBLAZE_DAEMON_START_PID" "$TRAILBLAZE_START_OWNER_IDENTITY" > "$lock_tmp" \
            || ! mv "$lock_tmp" "$TRAILBLAZE_START_OWNER_FILE"; then
            rm -f "$lock_tmp" "$TRAILBLAZE_START_OWNER_FILE"
            rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null || true
            kill "$TRAILBLAZE_DAEMON_START_PID" 2>/dev/null || true
            printf 'ERROR: could not record the Trailblaze daemon startup owner.\n' >&2
            return 1
        fi
        reap_daemon_startup_claim
        return 0
    else
        claim_exit=$?
    fi

    [ "$claim_exit" -eq 1 ] || return 1
    TRAILBLAZE_DAEMON_START_PID="$TRAILBLAZE_EXISTING_START_PID"
    return 0
}

release_daemon_startup() {
    if [ "${TRAILBLAZE_DAEMON_START_OWNER:-false}" = true ]; then
        # Readiness ends this caller's wait, not the daemon child's ownership. Keep the reaper and
        # claim while that exact child is alive so a transient /ping miss cannot elect a competitor.
        if [ -n "${TRAILBLAZE_DAEMON_START_PID:-}" ] \
            && process_is_alive "$TRAILBLAZE_DAEMON_START_PID"; then
            return 0
        fi
        if [ -n "${TRAILBLAZE_DAEMON_START_REAPER_PID:-}" ]; then
            kill "$TRAILBLAZE_DAEMON_START_REAPER_PID" 2>/dev/null || true
            wait "$TRAILBLAZE_DAEMON_START_REAPER_PID" 2>/dev/null || true
            TRAILBLAZE_DAEMON_START_REAPER_PID=""
        fi
        if [ -f "${TRAILBLAZE_START_OWNER_FILE:-}" ] \
            && rm -f "$TRAILBLAZE_START_OWNER_FILE"; then
            rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null || true
        fi
    fi
}

# ---------------------------------------------------------------------------
# CLI-via-daemon IPC fast path
# ---------------------------------------------------------------------------
#
# When the daemon is already running, forward argv to it over HTTP instead of
# spinning up a fresh JVM. The daemon runs the picocli command in-process and
# returns {stdout, stderr, exitCode}; this shim prints them and exits.
#
# The daemon is the single source of truth for which subcommands it will run
# in-process (TrailblazeCli.FORWARDABLE_SUBCOMMANDS). Anything else responds
# with forwarded=false and we fall through.
#
# We pre-filter on the same predicate the daemon applies — argv[0] against the
# allowlist, nothing more — because "one localhost round-trip" is only cheap
# when the daemon is healthy. A daemon that accepts connections but never
# answers (it still serves /ping, so nothing upstream notices) makes that
# round-trip cost the full `--max-time` below, and it charges that to commands
# the daemon was never going to run: `trailblaze run`, `device`, `report`, and
# every typo. Skipping the POST for those is what keeps a sick daemon from
# taking down the commands that do not need it.
#
# Version drift between this shim and the daemon is safe in both directions:
# a subcommand this list doesn't know is simply not forwarded and takes the
# JVM path, which is where an unforwardable one ends up anyway. Safe, but silent
# — a subcommand added daemon-side and not here just quietly goes back to paying
# JVM startup, with nothing failing to say so. The launcher's own shell test
# diffs this line against the Kotlin set so the drift is loud instead; keep the
# declaration on one line and space-separated, because that check parses it.
TRAILBLAZE_IPC_FORWARDABLE_SUBCOMMANDS="snapshot ask config tool"
#
# Falls through to the normal JVM path if:
#   - jq isn't installed (we can't assemble/parse JSON safely without it)
#   - argv[0] is not a subcommand the daemon runs in-process
#   - the daemon is unreachable
#   - the daemon responds with forwarded=false (subcommand not in allowlist)
#   - the curl POST fails for any reason (HTTP error, network blip)
#
# Disable explicitly with `--direct` or `--no-daemon` on the CLI, or by setting
# TRAILBLAZE_IPC=0 in the environment.

# How long a forwarded command may run before the wait is announced. Forwarding
# exists because it beats a ~1s JVM start, so anything past this is unexpected
# for every forwarded subcommand except `ask`.
TRAILBLAZE_IPC_NOTICE_SECONDS=10

# Decode one /cli/exec response and replay it on this shell's stdout and stderr, in the order
# the daemon's command actually wrote it.
#
# The daemon sends `transcript`: both streams as one ordered list of tagged chunks. Replaying
# all of stdout and then all of stderr — which is all an older daemon's response supports, and
# what the fallback below still does — reorders a command's output against itself, so an error
# and the tip that explains it end up with an unrelated status line between them.
#
# Returns 1 without printing anything when the body is not a usable forwarded response, so the
# caller can fall through to the JVM path. On success, sets IPC_REPLAY_EXIT_CODE.
# Marks a decode that ran to completion. Any value works as long as it cannot collide with a
# stream tag ("1"/"2") or an exit code, which is why it is not a bare number.
IPC_REPLAY_TERMINATOR='__tb_end__'

ipc_replay_response() {
    local response="$1"
    IPC_REPLAY_EXIT_CODE=1

    # Validate and decode in ONE jq process: the exit code, then a (stream, text) pair per chunk,
    # then a terminator. NUL delimiters let bash `read` preserve trailing newlines exactly;
    # command substitution strips them, which used to smash the first stderr line onto the last
    # stdout line.
    #
    # The terminator is what makes a partial decode detectable. jq streams, so a filter that dies
    # partway has already written everything before the failure: a forwarded body whose
    # `transcript` is an object, say, emits the exit code and then errors inside `map`. jq's own
    # non-zero status is unreachable here — it is the left side of a pipe inside a process
    # substitution — so without a terminator that wreckage arrives as a field count of 1, which is
    # indistinguishable from a well-formed "exit code, no chunks" response. The shim would report
    # success having replayed nothing, silently swallowing the command's whole output instead of
    # falling through to the slow path. Only a filter that ran to completion emits the terminator.
    local fields=()
    local field
    while IFS= read -r -d '' field; do
        fields+=("$field")
    done < <(printf '%s' "$response" | jq -j --arg end "$IPC_REPLAY_TERMINATOR" '
      if (.forwarded // false) != true then
        error("not forwarded")
      else
        (
          if (.exitCode | type) == "number" then
            (.exitCode | floor | if . < 0 then 256 + (. % 256) elif . > 255 then . % 256 else . end)
          else 1 end
          | tostring
        ), "\u0000",
        (
          (
            if ((.transcript // []) | length) > 0 then
              (.transcript | map({ s: (if .stream == "stderr" then "2" else "1" end), t: (.text // "") }))
            else
              [ { s: "1", t: (.stdout // "") }, { s: "2", t: (.stderr // "") } ]
            end
          )
          | map(select(.t != ""))
          | .[]
          | (.s, "\u0000", .t, "\u0000")
        ),
        $end, "\u0000"
      end
    ' 2>/dev/null)
    # The exit code, then whole (stream, text) pairs, then the terminator. Any other shape is a
    # response we could not decode — fall through rather than replay half of it.
    [ "${#fields[@]}" -ge 2 ] || return 1
    local last=$(( ${#fields[@]} - 1 ))
    [ "${fields[$last]}" = "$IPC_REPLAY_TERMINATOR" ] || return 1
    [ $(( (${#fields[@]} - 2) % 2 )) -eq 0 ] || return 1

    local exit_code="${fields[0]}"
    [[ "$exit_code" =~ ^[0-9]+$ ]] || exit_code=1

    local i=1
    while [ "$i" -lt "$last" ]; do
        if [ "${fields[$i]}" = "2" ]; then
            printf '%s' "${fields[$((i + 1))]}" >&2
        else
            printf '%s' "${fields[$((i + 1))]}"
        fi
        i=$((i + 2))
    done

    IPC_REPLAY_EXIT_CODE="$exit_code"
    return 0
}

# Attempt to run via the daemon's /cli/exec endpoint.
# On success replays the command's output and exits with the daemon's exit code.
# On any form of failure, returns 1 so the caller can fall through.
ipc_try_forward() {
    command -v jq >/dev/null 2>&1 || return 1

    # Same test the daemon runs on the other side (`args.firstOrNull() !in
    # FORWARDABLE_SUBCOMMANDS`): argv[0] verbatim, no flag skipping, so a command
    # this shim forwards is one the daemon agrees to run.
    #
    # Whole-word equality, not a substring probe on the space-joined list. Kotlin
    # compares argv[0] against a set of single tokens, so one argument that spells
    # two adjacent entries — `trailblaze "snapshot ask"` — is rejected there. A
    # substring probe accepted it here and spent the full `--max-time` finding out.
    local ipc_requested="${1:-}" ipc_candidate ipc_forwardable=
    for ipc_candidate in $TRAILBLAZE_IPC_FORWARDABLE_SUBCOMMANDS; do
        if [ "$ipc_requested" = "$ipc_candidate" ]; then
            ipc_forwardable=1
            break
        fi
    done
    [ -n "$ipc_forwardable" ] || return 1
    # Forward the user's interactive shell env vars that drive CLI resolution. The
    # daemon's own JVM env was captured at `app start` time, so `System.getenv`
    # on the daemon side never sees an `export TRAILBLAZE_DEVICE=…` the user did
    # after the daemon started. Without this forwarding, forwarded subcommands
    # (`snapshot`, `ask`, `config`) silently ignored the shell pin — the bug that
    # made `trailblaze snapshot` fail with "multiple devices connected" right
    # after the user did exactly what the error's own hint told them to do.
    #
    # ALLOWLIST — env vars safe to forward across the loopback /cli/exec boundary.
    # This is a security boundary: anything added here ships to the daemon's
    # `CliCallerContext.callerEnv` and is visible to forwarded subcommands.
    # Don't add general shell env (PATH, HOME, etc.) — only TRAILBLAZE_* vars
    # that drive CLI resolution. Keep this list in sync with `CliCallerContext`
    # consumers in `CliInfrastructure.kt` — one `env*()` / `resolveCli*()`
    # reader function per allowlisted var.
    #
    # TRAILBLAZE_MCP_REQUEST_TIMEOUT_MS is on the list because the CLI's own timeout
    # error tells the user to raise it, and a forwarded command's timeout is decided
    # in the daemon's JVM: without forwarding, following that advice changed nothing
    # for `snapshot`, `ask`, `tool` and `config`. Read by
    # `CliMcpClient.resolveRequestTimeoutMs`.
    #
    # Build argv + cwd + env in ONE jq process. The old implementation appended every
    # argument and env var with a separate jq invocation, then spawned another jq for the
    # final payload. A three-argument snapshot with the standard shell metadata paid for six
    # short-lived jq processes before curl even started. `--args` preserves every argument
    # byte (including embedded newlines) without an in-band delimiter.
    # Send the user's interactive cwd alongside argv so commands that walk relative
    # paths (e.g. `waypoint --target` resolving the workspace anchor) anchor at the
    # user's shell directory rather than the daemon's launch directory. Older daemons
    # ignore unknown fields (kotlinx.serialization with ignoreUnknownKeys=true);
    # newer daemons fall back to their own cwd/env if absent. See [CliCallerContext].
    local payload
    payload=$(jq -cn \
        --arg cwd "$PWD" \
        --arg device "${TRAILBLAZE_DEVICE:-}" \
        --arg target "${TRAILBLAZE_TARGET:-}" \
        --arg shell_pid "${TRAILBLAZE_SHELL_PID:-}" \
        --arg interactive "${TRAILBLAZE_INTERACTIVE:-}" \
        --arg mcp_timeout "${TRAILBLAZE_MCP_REQUEST_TIMEOUT_MS:-}" \
        --arg preflight_timeout "${TRAILBLAZE_MCP_PREFLIGHT_TIMEOUT_MS:-}" \
        --args '
          {
            args: $ARGS.positional,
            cwd: $cwd,
            env: (
              {}
              + (if $device == "" then {} else {TRAILBLAZE_DEVICE: $device} end)
              + (if $target == "" then {} else {TRAILBLAZE_TARGET: $target} end)
              + (if $shell_pid == "" then {} else {TRAILBLAZE_SHELL_PID: $shell_pid} end)
              + (if $interactive == "" then {} else {TRAILBLAZE_INTERACTIVE: $interactive} end)
              + (if $mcp_timeout == "" then {} else {TRAILBLAZE_MCP_REQUEST_TIMEOUT_MS: $mcp_timeout} end)
              + (if $preflight_timeout == "" then {} else {TRAILBLAZE_MCP_PREFLIGHT_TIMEOUT_MS: $preflight_timeout} end)
            )
          }
        ' -- "$@") || return 1

    # The daemon can hold this request open for minutes on purpose — `ask` runs a
    # whole agent in there — so the timeout stays generous. What isn't acceptable
    # is doing it in silence: a caller watching a blank terminal cannot tell a
    # daemon that is working from one that will never answer. Announce the wait
    # once, from a watchdog that dies as soon as the response lands, so a healthy
    # fast command still prints nothing extra.
    # Why the fds here matter at all: everything this spawns inherits them, and a
    # caller capturing output — `out=$(trailblaze config show)` — sees EOF only
    # once EVERY holder of the pipe's write end closes it. A watchdog left holding
    # that pipe makes even an instant forward take the full notice threshold. The
    # group kill below is what guarantees nothing is left holding it; sending
    # stdout to /dev/null is the narrower guarantee that survives even the
    # fallback path, where there is no process group to kill.
    #
    # `set -m` for the spawn so the watchdog becomes a process-group leader and
    # the whole group can be killed at once. Killing just the subshell leaves the
    # `sleep` it forked alive — and that child is reparented to init the moment
    # its parent dies, so `pkill -P` no longer finds it either.
    local notice_pid
    set -m
    {
        sleep "$TRAILBLAZE_IPC_NOTICE_SECONDS"
        echo "Waiting for the Trailblaze daemon on port ${TRAILBLAZE_PORT} to respond..." >&2
        # No `--no-daemon` hint here: none of the forwardable subcommands accept that flag
        # (only `trail` and `mcp` do), so the old hint sent users to an "Unknown option" error.
        echo "  It may be busy with another command. 'trailblaze status' shows the daemon; 'trailblaze stop' restarts it fresh on the next command." >&2
    } > /dev/null &
    notice_pid=$!
    set +m
    # Off the jobs table, or bash reports "Terminated" on this command's stderr
    # when it reaps the watchdog we killed — noise on every forwarded command.
    # The process group is unaffected, so the kill below still reaches it.
    disown "$notice_pid" 2> /dev/null || true

    # This ceiling has to cover the budget the forwarded command itself waits on:
    # the CLI's default request budget (CliMcpClient.DEFAULT_REQUEST_TIMEOUT_MS)
    # plus the same 30 s margin, or the override below when that is larger.
    # Abandoning the forward does not cancel the command — the daemon keeps running
    # it. So a user who takes the CLI's advice and raises
    # TRAILBLAZE_MCP_REQUEST_TIMEOUT_MS past this would see the launcher give up on
    # a command that is still going. Non-numeric and smaller values keep the
    # standard ceiling: the point is to never sit below the forwarded budget, not
    # to track it. A test pins this floor against the CLI default.
    #
    # The daemon reads the same value with Kotlin's `toLongOrNull`, which accepts a
    # leading `+` and leading zeros. Bash does not: the pattern below would reject
    # the `+`, and arithmetic reads a leading zero as octal. Normalize first so both
    # sides agree on the budget; past 18 digits Kotlin gives up on the value and so
    # do we, rather than let the arithmetic wrap.
    local ipc_max_time=660
    local ipc_budget_ms="${TRAILBLAZE_MCP_REQUEST_TIMEOUT_MS:-}"
    ipc_budget_ms="${ipc_budget_ms#+}"
    case "$ipc_budget_ms" in
        '' | *[!0-9]*) ;;
        *)
            if [ "${#ipc_budget_ms}" -le 18 ]; then
                ipc_budget_ms=$((10#$ipc_budget_ms))
                if [ "$ipc_budget_ms" -gt $(((ipc_max_time - 30) * 1000)) ]; then
                    ipc_max_time=$((ipc_budget_ms / 1000 + 30))
                fi
            fi
            ;;
    esac

    local response rc
    response=$(curl -sS --connect-timeout 2 --max-time "$ipc_max_time" \
        -X POST "http://localhost:${TRAILBLAZE_PORT}/cli/exec" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>/dev/null)
    rc=$?
    # The group, not just the leader: a surviving `sleep` holds this command's
    # stderr, and a caller capturing it waits for every holder of the write end
    # to close — which would make even an instant forward take the full notice
    # threshold. `kill "$notice_pid"` as well, for a shell that gave the job no
    # group of its own.
    kill -- "-$notice_pid" 2> /dev/null || kill "$notice_pid" 2> /dev/null
    if [ "$rc" -eq 28 ]; then
        # curl 28 is curl's own clock running out — `--connect-timeout` or `--max-time`.
        # The daemon answered /ping a moment ago, so this is a daemon that is starved
        # or is still running the command, and the ceiling above can only ever
        # approximate how long that takes (the daemon's own setup runs before the
        # budgeted action). Falling through here would run the command a SECOND time
        # in a fresh JVM — a second tap, a second app launch — so fail instead, with
        # the infra exit code the CLI itself uses for a daemon that did not answer.
        printf '%s\n' \
            "trailblaze: no answer from the Trailblaze daemon on port ${TRAILBLAZE_PORT} within ${ipc_max_time}s." \
            "  If the daemon accepted the command it is still running it; the command was NOT re-run." \
            "  'trailblaze status' shows the daemon; 'trailblaze stop' restarts it fresh on the next command." >&2
        exit 2
    fi
    [ "$rc" -eq 0 ] || return 1

    ipc_replay_response "$response" || return 1
    exit "$IPC_REPLAY_EXIT_CODE"
}

show_window() {
    curl -s -X POST "http://localhost:${TRAILBLAZE_PORT}/cli/show-window" \
        -H "Content-Type: application/json" \
        -d '{}' > /dev/null 2>&1
}

fetch_daemon_status_json() {
    curl -s --max-time 5 "http://localhost:${TRAILBLAZE_PORT}/cli/status" 2>/dev/null
}

# One scalar field out of the status JSON, string or number. Enough for the flat fields the
# launcher reads; nothing here parses nested values.
#
# jq when it is there, because the sed fallback reads a value up to the first `"` and so truncates
# any field containing an escaped quote — a workspace path is the realistic one. The fallback stays
# because jq is not a Trailblaze dependency, and the fields this reads (pid, version, counts) are
# quote-free in practice.
status_json_field() {
    local json="$1" key="$2" value
    if command -v jq > /dev/null 2>&1; then
        value=$(printf '%s' "$json" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null)
        printf '%s' "$value"
        return 0
    fi
    value=$(printf '%s' "$json" | sed -n 's/.*"'"$key"'":"\([^"]*\)".*/\1/p')
    [ -n "$value" ] || value=$(printf '%s' "$json" | sed -n 's/.*"'"$key"'":\([^,}"]*\).*/\1/p')
    printf '%s' "$value"
}

# Whether $1 looks like a Trailblaze daemon JVM rather than whatever else the OS has given that
# number to. Used only for the pidfile, which is the one source nothing corroborates: it outlives
# reboots, so on a long-lived machine it can name a process the OS handed to someone else — and the
# callers of this end in `kill -9`. Deliberately loose (any JVM, or anything naming Trailblaze), so
# it rules out the editor or browser that inherited the number without ever refusing to stop a real
# daemon, which would be the worse failure of the two.
pid_looks_like_trailblaze() {
    case "$(LC_ALL=C ps -o command= -p "$1" 2>/dev/null)" in
        *trailblaze* | *Trailblaze* | *java*) return 0 ;;
        *) return 1 ;;
    esac
}

# The PID of the process serving the daemon port. The pidfile alone is not it: a daemon the CLI
# auto-started from inside its own JVM never wrote one, so after a launcher-started daemon dies
# and the CLI starts a replacement, the pidfile names a dead process while a live one answers.
#
# $1, when given, is a status body already fetched by the caller — `status` has one in hand and
# would otherwise pay a second five-second request for a field it already holds.
daemon_process_pid() {
    local pid status_json="${1-}"
    [ -n "$status_json" ] || status_json=$(fetch_daemon_status_json)
    pid=$(status_json_field "$status_json" pid)
    # Only a numeric answer counts. A garbled body would otherwise short-circuit the corroborated
    # sources below and leave the caller with "could not be identified".
    case "$pid" in 0* | *[!0-9]*) pid="" ;; esac
    if [ -z "$pid" ] && command -v lsof > /dev/null 2>&1; then
        pid=$(lsof -nP -t -iTCP:"${TRAILBLAZE_PORT}" -sTCP:LISTEN 2>/dev/null | head -n 1)
        case "$pid" in 0* | *[!0-9]*) pid="" ;; esac
        # This is the port's real owner, and a daemon that answered /cli/status without a pid is
        # indistinguishable here from an unrelated HTTP server on the same port. If it does not
        # look like a Trailblaze JVM, give up entirely rather than falling through to the pidfile:
        # that would name a process which does not even hold the port, and these paths end in
        # `kill -9`.
        if [ -n "$pid" ] && ! pid_looks_like_trailblaze "$pid"; then
            return 1
        fi
    fi
    if [ -z "$pid" ]; then
        pid=$(cat "$TRAILBLAZE_PIDFILE" 2>/dev/null)
        case "$pid" in "" | 0* | *[!0-9]*) return 1 ;; esac
        pid_looks_like_trailblaze "$pid" || return 1
    fi
    case "$pid" in "" | 0* | *[!0-9]*) return 1 ;; esac
    printf '%s' "$pid"
}

# Polls in half-second steps; $2 is the number of steps.
wait_for_process_exit() {
    local waited=0
    while process_is_alive "$1" && [ "$waited" -lt "$2" ]; do
        sleep 0.5
        waited=$((waited + 1))
    done
    ! process_is_alive "$1"
}

# TERM first so shutdown hooks get their turn, KILL when they cannot finish — the wedge this
# covers is a daemon whose own shutdown path is what is blocked.
terminate_process() {
    kill "$1" 2>/dev/null || true
    wait_for_process_exit "$1" 10 && return 0
    kill -9 "$1" 2>/dev/null || true
    wait_for_process_exit "$1" 10
}

stop_daemon() {
    local daemon_pid attempts probe
    probe_daemon_port
    probe=$?
    if [ "$probe" -eq 1 ]; then
        echo "Trailblaze is not running."
        return 0
    fi

    daemon_pid=$(daemon_process_pid) || daemon_pid=""

    if [ "$probe" -eq 2 ]; then
        # Something holds the port and cannot answer — the exact state `stop` exists for. Reporting
        # it as "not running" left the wedge in place and exited 0, so the next start failed on a
        # bound port with no explanation. Asking it to shut down politely would go where the ping
        # went, so go straight to the process.
        stop_daemon_by_signal "$daemon_pid" "Trailblaze is not answering on port ${TRAILBLAZE_PORT}" || return 1
        finish_daemon_stop "$daemon_pid"
        return 0
    fi

    echo "Stopping Trailblaze..."
    # Bounded: a daemon that accepts the socket and then never answers must not park `stop` here,
    # because the TERM/KILL escalation below is what actually ends that daemon.
    curl -s -X POST --connect-timeout 2 --max-time 10 "http://localhost:${TRAILBLAZE_PORT}/cli/shutdown" \
        -H "Content-Type: application/json" \
        -d '{}' > /dev/null 2>&1

    # Poll only while the daemon is still ANSWERING (status 0) — that is a daemon shutting down in
    # an orderly way, and it deserves the few seconds. Status 2 means it stopped answering without
    # closing the port, which is the wedge, and no amount of waiting fixes it: each of those probes
    # costs the full ping timeout, so continuing to poll spends a minute before the escalation that
    # was always going to be the answer.
    attempts=0
    probe_daemon_port
    probe=$?
    while [ "$probe" -eq 0 ] && [ "$attempts" -lt 10 ]; do
        sleep 0.5
        attempts=$((attempts + 1))
        probe_daemon_port
        probe=$?
    done

    if [ "$probe" -ne 1 ]; then
        # Still holding the port, whether it is still answering or went deaf while shutting down.
        # Both need the same thing done to them — and the second is why this asks the port again
        # rather than trusting the loop's own last answer.
        stop_daemon_by_signal "$daemon_pid" "Trailblaze did not stop on request" || return 1
    elif [ -n "$daemon_pid" ] && ! wait_for_process_exit "$daemon_pid" 10; then
        # The port closed, so every readiness probe says "stopped", but the JVM is still here —
        # and with it every subprocess it owns. Left alone it holds the device connections and
        # the next start finds a live PID it refuses to start past.
        echo "Trailblaze closed its port but process ${daemon_pid} did not exit; stopping it directly." >&2
        if ! terminate_process "$daemon_pid"; then
            echo "Daemon process ${daemon_pid} is still running. Stop it yourself: kill -9 ${daemon_pid}" >&2
            return 1
        fi
    fi

    finish_daemon_stop "$daemon_pid"
    return 0
}

# End the daemon's process and confirm the port came free with it. $2 is why we are escalating; it
# leads both the action line and the could-not-identify line so every path explains itself the same
# way. Returns non-zero, having said what to do next, when the daemon is still there afterwards.
stop_daemon_by_signal() {
    local daemon_pid="$1" reason="$2" probe
    if [ -z "$daemon_pid" ]; then
        echo "${reason}, and its process could not be identified." >&2
        echo "  Find it with: lsof -nP -iTCP:${TRAILBLAZE_PORT} -sTCP:LISTEN" >&2
        return 1
    fi
    echo "${reason}; stopping daemon process ${daemon_pid} directly." >&2
    if ! terminate_process "$daemon_pid"; then
        echo "Daemon process ${daemon_pid} is still running. Stop it yourself: kill -9 ${daemon_pid}" >&2
        return 1
    fi
    # The process is gone, so the port must be too. Anything else means what we ended was not what
    # holds it — say so instead of reporting a stop that did not happen.
    probe_daemon_port
    probe=$?
    if [ "$probe" -ne 1 ]; then
        echo "Daemon process ${daemon_pid} ended but port ${TRAILBLAZE_PORT} is still held." >&2
        echo "  Find its owner: lsof -nP -iTCP:${TRAILBLAZE_PORT} -sTCP:LISTEN" >&2
        return 1
    fi
    return 0
}

# Clears the state a stopped daemon leaves behind, and says it stopped. Shared by every path
# through stop_daemon so a daemon ended by signal cleans up exactly like one that shut itself down.
finish_daemon_stop() {
    local daemon_pid="${1:-}" stopped_pid
    # Release the startup claim if the daemon just stopped held it, or if whoever held it is gone.
    # A CLI-started daemon's claim names the launcher shell that wrapped its JVM, not the pidfile's
    # PID, so matching the pidfile alone left the claim behind after every such stop.
    stopped_pid=$(cat "$TRAILBLAZE_PIDFILE" 2>/dev/null)
    read_daemon_startup_owner || true
    if [ -n "${TRAILBLAZE_START_OWNER_FILE:-}" ] \
        && { [ "${TRAILBLAZE_START_OWNER_PID:-}" = "${stopped_pid:-none}" ] \
            || [ "${TRAILBLAZE_START_OWNER_PID:-}" = "${daemon_pid:-none}" ] \
            || ! daemon_startup_owner_alive; }; then
        if [ -f "$TRAILBLAZE_START_OWNER_FILE" ] \
            && rm -f "$TRAILBLAZE_START_OWNER_FILE"; then
            rmdir "$TRAILBLAZE_START_LOCK" 2>/dev/null || true
        fi
    fi
    rm -f "$TRAILBLAZE_PIDFILE"
    echo "Trailblaze stopped."
}

format_uptime() {
    # `${1-0}`, not `${1:-0}` — an empty argument is a daemon that did not report an uptime, and
    # must reach the 'unknown' arm below rather than being substituted into a confident "0s".
    local total="${1-0}"
    case "$total" in "" | *[!0-9]*) printf 'unknown'; return ;; esac
    if [ "$total" -ge 3600 ]; then
        printf '%dh %dm' "$((total / 3600))" "$((total % 3600 / 60))"
    elif [ "$total" -ge 60 ]; then
        printf '%dm %ds' "$((total / 60))" "$((total % 60))"
    else
        printf '%ds' "$total"
    fi
}

# The `--json` answer for a daemon that cannot be asked. $1 is a [probe_daemon_port] status.
#
# Carries every field `CliStatusResponse` declares without a default, so a consumer decoding this
# with the shipped serializer gets `running: false` rather than a missing-field failure — the
# stand-in has to satisfy the same schema as the real thing or it is not an answer.
not_running_status_json() {
    local unresponsive=false
    [ "${1:-}" = "2" ] && unresponsive=true
    printf '{"running":false,"port":%s,"connectedDevices":0,"uptimeSeconds":0,"unresponsive":%s}' \
        "$TRAILBLAZE_PORT" "$unresponsive"
}

# Whether $1 parses as a JSON object. Without `jq` this only rules out the obvious non-JSON bodies
# (an HTML error page, a bare 404 line), which is what it is here to catch.
json_is_object() {
    [ -n "$1" ] || return 1
    if command -v jq > /dev/null 2>&1; then
        printf '%s' "$1" | jq -e 'type == "object"' > /dev/null 2>&1
        return $?
    fi
    case "$1" in '{'*'}') return 0 ;; *) return 1 ;; esac
}

# One indented line per in-flight run.
#
# The sed fallback is anchored on `activeRunSummaries` being followed by `capabilities`, so adding a
# field between them makes the whole list vanish while the count above it still says there are runs.
# Nothing warns you about that, which is why jq gets first refusal.
status_active_run_lines() {
    local json="$1"
    if command -v jq > /dev/null 2>&1; then
        printf '%s' "$json" | jq -r '(.activeRunSummaries // [])[] | "    - " + .' 2>/dev/null
        return 0
    fi
    printf '%s' "$json" \
        | sed -n 's/.*"activeRunSummaries":\[\(.*\)\],"capabilities".*/\1/p' \
        | awk 'BEGIN { RS = "\",\"" } { gsub(/^"|"$/, ""); if (length($0)) print "    - " $0 }'
}

# `trailblaze status` is read by a person deciding whether to stop or restart the daemon, so it
# answers those questions directly. `trailblaze status --json` keeps the raw response for scripts.
get_status() {
    local json pid uptime version devices runs workspace probe
    probe_daemon_port
    probe=$?
    if [ "$probe" -ne 0 ]; then
        # --json is parsed by scripts, so it has to answer in JSON even when there is no daemon to
        # ask. Printing the human sentence there fed `jq` a parse error instead of "nothing running".
        if [ "${1:-}" = "--json" ]; then
            printf '%s\n' "$(not_running_status_json "$probe")"
            return 0
        fi
        if [ "$probe" -eq 2 ]; then
            # Not the same thing as "not running", and saying so would send the reader off to start
            # a daemon that cannot bind. `stop` is what clears this.
            echo "Trailblaze is not answering on port ${TRAILBLAZE_PORT}."
            echo "  Something holds the port but did not respond within ${TRAILBLAZE_PING_TIMEOUT_SECONDS}s."
            echo "  See who owns it:  lsof -nP -iTCP:${TRAILBLAZE_PORT} -sTCP:LISTEN"
            echo "  Clear it with:    trailblaze stop"
            return 0
        fi
        echo "Trailblaze is not running."
        return 0
    fi
    json=$(fetch_daemon_status_json)
    # A body that is not JSON is no better than no body — an older daemon answers /cli/status with
    # 404 text, and `--json` promised something parseable either way.
    json_is_object "$json" || json=""
    if [ "${1:-}" = "--json" ]; then
        [ -n "$json" ] || json="$(not_running_status_json 0)"
        printf '%s\n' "$json"
        return 0
    fi
    # Older daemons do not report their PID; fall back to the listening socket / pidfile. The body
    # already in hand is passed along so this does not pay a second request for a field it holds.
    pid=$(daemon_process_pid "$json" 2>/dev/null || true)
    uptime=$(format_uptime "$(status_json_field "$json" uptimeSeconds)")
    version=$(status_json_field "$json" version)
    devices=$(status_json_field "$json" connectedDevices)
    runs=$(status_json_field "$json" activeRuns)
    workspace=$(status_json_field "$json" workspaceAnchor)
    echo "Trailblaze is running on port ${TRAILBLAZE_PORT}${pid:+ (PID ${pid})}, up ${uptime}."
    echo "  Version:   ${version:-unknown}"
    echo "  Devices:   ${devices:-0} connected"
    echo "  Runs:      ${runs:-0} active"
    echo "  Workspace: ${workspace:-none (scratch)}"
    if [ "${runs:-0}" != "0" ]; then
        status_active_run_lines "$json"
    fi
    echo "  Log:       ${TRAILBLAZE_DAEMON_LOG}"
}

# Open Trail Runner in its native desktop shell. Bare `app` and `app start`
# continue to launch the legacy Compose desktop app; `--v2` is the explicit
# opt-in while the replacement is still being validated.
open_trailrunner_window() {
    # Companion re-enters this launcher after connecting so it gets the same native shell as
    # `trailblaze trailrunner`, but opens directly on the newly attached run. This variable is
    # launcher-to-launcher plumbing, not a user-facing configuration knob.
    local url="${TRAILBLAZE_TRAILRUNNER_URL:-http://localhost:${TRAILBLAZE_PORT}/trailrunner/}"
    echo "Opening Trail Runner at $url" >&2

    if [[ "$(uname)" == "Darwin" ]]; then
        local shell_url="http://localhost:${TRAILBLAZE_PORT}/trailrunner/native/TrailblazeTrailRunner.swift"
        local shell_dir="${HOME}/.trailblaze/bin"
        local shell_src="${shell_dir}/TrailblazeTrailRunner.swift"
        local shell_bin="${shell_dir}/Trail Runner"
        mkdir -p "$shell_dir"

        if ! curl -sf -o "${shell_src}.new" "$shell_url"; then
            echo "ERROR: could not fetch the Trail Runner shell from $shell_url." >&2
            echo "       Open $url in a browser, or restart the daemon and retry." >&2
            return 1
        fi
        if [ ! -f "$shell_src" ] || ! cmp -s "${shell_src}.new" "$shell_src" || [ ! -x "$shell_bin" ]; then
            mv "${shell_src}.new" "$shell_src"
            echo "Compiling native Trail Runner shell..." >&2
            if ! xcrun swiftc -O -o "$shell_bin" "$shell_src" -framework Cocoa -framework WebKit; then
                echo "ERROR: failed to compile Trail Runner with 'xcrun swiftc'." >&2
                echo "       Install Xcode command-line tools, then retry. You can still open $url." >&2
                return 1
            fi
        else
            rm -f "${shell_src}.new"
        fi
        # Keep the current window alive until its replacement has been fetched and compiled.
        # Closing it immediately before launch also leaves one authoritative app window focused.
        pkill -f "bin/Trail Runner .*:${TRAILBLAZE_PORT}/" 2>/dev/null || true
        nohup "$shell_bin" "$url" >/dev/null 2>&1 &
        disown
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url"
    else
        echo "Open this URL in your browser: $url" >&2
    fi
}

# Make the repo containing the caller's current directory the active Trail Runner workspace. The
# daemon is long-lived, so inheriting cwd only works on its first launch; this explicit handoff also
# makes a later `trailblaze app` from another checkout switch the already-running app. The daemon
# scans this whole root recursively (including layouts such as `jobs/**/trails`).
activate_trailrunner_workspace() {
    local repo_root
    if ! repo_root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
        return 0
    fi
    if curl -sf -X PUT --data-urlencode "path=${repo_root}" \
        "http://localhost:${TRAILBLAZE_PORT}/trailrunner/api/workspace" >/dev/null; then
        printf '%s\n' "Active workspace: ${repo_root}" >&2
        return 0
    fi
    printf '%s\n' "WARNING: the app opened, but could not switch its workspace to ${repo_root}." >&2
    return 1
}

launch_trailrunner_app() {
    if ! is_daemon_running; then
        tb_check_java_version || return 1
        local daemon_pid
        echo "Starting Trailblaze daemon..." >&2
        start_daemon_background normal || return 1
        daemon_pid="$TRAILBLAZE_DAEMON_START_PID"
        if [ "$TRAILBLAZE_DAEMON_START_OWNER" != true ]; then
            printf 'A Trailblaze daemon is already starting (PID %s) — waiting for it.\n' "$daemon_pid" >&2
        fi

        echo -n "Waiting for Trailblaze daemon" >&2
        local attempts=0
        while [ "$attempts" -lt 120 ] && ! is_daemon_running; do
            if ! process_is_alive "$daemon_pid"; then
                release_daemon_startup
                printf '\nERROR: the Trailblaze daemon exited during startup. See %s\n' "$TRAILBLAZE_DAEMON_LOG" >&2
                return 1
            fi
            echo -n "." >&2
            sleep 1
            attempts=$((attempts + 1))
        done
        echo "" >&2
        if ! is_daemon_running; then
            echo "ERROR: Trailblaze did not become ready on port ${TRAILBLAZE_PORT}." >&2
            return 1
        fi
        release_daemon_startup
        echo "Trailblaze daemon ready." >&2
    fi
    # Companion already selected and validated its workspace before connecting. Activating cwd
    # here could switch a long-lived daemon away from that root between connect and first render.
    if [ -z "${TRAILBLAZE_TRAILRUNNER_URL:-}" ]; then
        activate_trailrunner_workspace || true
    fi
    open_trailrunner_window
}

# ---------------------------------------------------------------------------
# Path resolution helper
# ---------------------------------------------------------------------------

to_absolute_path() {
    local path="$1"
    if [ -f "$path" ]; then
        echo "$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
    elif [ -d "$path" ]; then
        echo "$(cd "$path" && pwd)"
    else
        echo "$path"
    fi
}

# Companion roots are interpreted relative to the caller even when they do not exist yet. Source
# and Gradle launchers change cwd before the JVM starts, so preserve that origin in the argv.
to_absolute_companion_root() {
    local resolved
    resolved=$(to_absolute_path "$1")
    if [ -z "$resolved" ] || [[ "$resolved" = /* ]]; then
        echo "$resolved"
    else
        echo "$PWD/$resolved"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

# Process arguments: resolve file paths to absolute and detect STDIO mode.
# Uses an array to preserve quoting for arguments with spaces (e.g., --yaml YAML).
STDIO_MODE=false
HAS_HTTP=false
HAS_DIRECT=false
NATIVE_APP_MODE=false
ARGS_ARRAY=()
companion_expect_trails_dir=false
for arg in "$@"; do
    if [ "$arg" = "--http" ]; then
        HAS_HTTP=true
    fi
    if [ "$arg" = "--direct" ] || [ "$arg" = "--no-daemon" ]; then
        HAS_DIRECT=true
    fi

    # Only resolve paths that look like file/dir references (contain / or .)
    # Don't resolve bare words like "web", "android", "ios" — they're command arguments
    # Companion owns its path semantics: --folder stays relative to --trails-dir,
    # while the Kotlin command canonicalizes only --trails-dir itself.
    if [ "${1:-}" = "companion" ]; then
        if [ "$companion_expect_trails_dir" = true ]; then
            resolved_arg=$(to_absolute_companion_root "$arg")
            companion_expect_trails_dir=false
        elif [[ "$arg" == --trails-dir=* ]]; then
            resolved_arg="--trails-dir=$(to_absolute_companion_root "${arg#--trails-dir=}")"
        else
            resolved_arg="$arg"
            [ "$arg" = "--trails-dir" ] && companion_expect_trails_dir=true
        fi
    elif [[ "$arg" == */* ]] || [[ "$arg" == *.* ]]; then
        resolved_arg=$(to_absolute_path "$arg")
    else
        resolved_arg="$arg"
    fi
    ARGS_ARRAY+=("$resolved_arg")
done

# Source/Gradle execution changes cwd before starting the JVM. Preserve the caller's workspace as
# Companion's default explicitly; installed JAR mode gets the same argv for one consistent contract.
if [ "${1:-}" = "companion" ] && [ "${2:-}" = "start" ]; then
    companion_has_trails_dir=false
    for arg in "$@"; do
        if [ "$arg" = "--trails-dir" ] || [[ "$arg" == --trails-dir=* ]]; then
            companion_has_trails_dir=true
            break
        fi
    done
    if [ "$companion_has_trails_dir" = false ]; then
        ARGS_ARRAY+=("--trails-dir" "$PWD")
    fi
fi
# Flat string for functions that need it (backward compat)
ARGS="${ARGS_ARRAY[*]}"

if [ "${#ARGS_ARRAY[@]}" -eq 1 ] && [ "${ARGS_ARRAY[0]}" = "trailrunner" ]; then
    NATIVE_APP_MODE=true
elif [ "${#ARGS_ARRAY[@]}" -eq 2 ] && [ "${ARGS_ARRAY[0]}" = "app" ] && [ "${ARGS_ARRAY[1]}" = "--v2" ]; then
    NATIVE_APP_MODE=true
fi

# STDIO mode: `mcp` subcommand without `--http` flag (`--direct` / `--no-daemon` included)
if [ "${1:-}" = "mcp" ] && [ "$HAS_HTTP" = false ]; then
    STDIO_MODE=true
fi

# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------

# Every branch below either spawns a daemon or attaches to one, except `stop` and `status`, which
# act on whatever is already running and must keep working on a port the guard rejects.
if [ "${1:-}" != "stop" ] && [ "${1:-}" != "status" ]; then
    require_usable_daemon_port
fi

if [ "$NATIVE_APP_MODE" = true ]; then
    launch_trailrunner_app
elif [ "$1" = "stop" ]; then
    stop_daemon
elif [ "$1" = "status" ]; then
    get_status "${2:-}"
elif [ "${TRAILBLAZE_IPC:-1}" = "1" ] \
    && [ "$HAS_DIRECT" = false ] \
    && [ "$STDIO_MODE" = false ] \
    && is_daemon_running; then
    # Fast path: forward to the already-running daemon instead of spawning a JVM.
    # ipc_try_forward either exits (success) or returns nonzero so we fall through
    # to the normal JVM path below.
    ipc_try_forward "${ARGS_ARRAY[@]}" || {
        tb_check_java_version || exit 1
        tb_run_quiet "${ARGS_ARRAY[@]}"
    }
elif [ "$STDIO_MODE" = true ]; then
    # STDIO MCP mode: quiet output so only JSON-RPC goes to stdout.

    # Auto-start daemon if not running (proxy needs it)
    if ! is_daemon_running; then
        if daemon_autostart_disabled; then
            # The proxy itself honors the same kill-switch (McpProxy.kt), so
            # requests will fail fast with a clear envelope instead of hanging.
            echo "[mcp] Daemon not running and TRAILBLAZE_DISABLE_DAEMON_AUTOSTART is set — not starting one." >&2
        elif daemon_port_held_by_unresponsive; then
            echo "[mcp] Port ${TRAILBLAZE_PORT} is held by something that does not answer /ping — not starting one." >&2
        else
            echo "[mcp] Starting Trailblaze daemon..." >&2
            # Ports are passed via exported TRAILBLAZE_PORT/TRAILBLAZE_HTTPS_PORT env vars
            tb_check_java_version || exit 1
            start_daemon_background quiet || exit 1
            printf '[mcp] Daemon starting (PID %s)...\n' "$TRAILBLAZE_DAEMON_START_PID" >&2

            attempts=0
            while [ $attempts -lt 60 ]; do
                if is_daemon_running; then
                    echo "[mcp] Daemon ready." >&2
                    release_daemon_startup
                    break
                fi
                if ! process_is_alive "$TRAILBLAZE_DAEMON_START_PID"; then
                    release_daemon_startup
                    printf '[mcp] Warning: daemon exited during startup. See %s\n' "$TRAILBLAZE_DAEMON_LOG" >&2
                    break
                fi
                sleep 1
                attempts=$((attempts + 1))
            done

            if ! is_daemon_running; then
                echo "[mcp] Warning: daemon did not start in time." >&2
            fi
        fi
    fi

    tb_check_java_version || exit 1
    tb_run_exec_quiet "${ARGS_ARRAY[@]}"
elif ([ "$1" = "trail" ] || [ "$1" = "run" ] || [ "$1" = "blaze" ] || [ "$1" = "ask" ] || ([ "$1" = "session" ] && [ "$2" != "info" ]) || [ "$1" = "tools" ]) && ! is_daemon_running && ! daemon_port_held_by_unresponsive && ! daemon_autostart_disabled; then
    # Auto-start daemon for commands that need it so subsequent calls reuse it.
    # Use stderr so --json output on stdout stays clean.
    echo "Starting Trailblaze daemon..." >&2
    # Ports are passed via exported TRAILBLAZE_PORT/TRAILBLAZE_HTTPS_PORT env vars
    tb_check_java_version || exit 1
    start_daemon_background normal || exit 1

    # Wait for daemon to be ready (all output to stderr for --json safety)
    echo -n "Waiting for Trailblaze daemon" >&2
    max_attempts=60
    attempts=0
    daemon_exited_during_startup=false
    while [ $attempts -lt $max_attempts ]; do
        if is_daemon_running; then
            echo "" >&2
            echo "Trailblaze daemon ready." >&2
            release_daemon_startup
            break
        fi
        if ! process_is_alive "$TRAILBLAZE_DAEMON_START_PID"; then
            release_daemon_startup
            daemon_exited_during_startup=true
            break
        fi
        echo -n "." >&2
        sleep 1
        attempts=$((attempts + 1))
    done

    # A daemon that died is not a daemon that was slow, and the two need
    # different things from the reader — one is a crash to look up in
    # daemon.log, the other is a machine to wait longer on. The other two
    # readiness polls already separate them.
    if ! is_daemon_running; then
        echo "" >&2
        if [ "$daemon_exited_during_startup" = true ]; then
            echo "Warning: the Trailblaze daemon exited during startup (see ${TRAILBLAZE_DAEMON_LOG}). Falling back to direct execution." >&2
        else
            echo "Warning: Daemon did not start in time. Falling back to direct execution." >&2
        fi
    fi

    # Now run the CLI command — TrailCommand will detect the daemon and delegate.
    # Use quiet mode to suppress Gradle build noise from user-facing output.
    tb_run_quiet "${ARGS_ARRAY[@]}"
    RUN_EXIT=$?

    # Keep daemon alive for all commands so subsequent runs reuse it.
    # Use `./trailblaze --stop` to shut it down explicitly.
    exit $RUN_EXIT
elif [ ${#ARGS_ARRAY[@]} -gt 0 ]; then
    # CLI command mode (config, auth, etc.)
    tb_check_java_version || exit 1
    tb_run_quiet "${ARGS_ARRAY[@]}"
else
    # No subcommand: show help
    tb_check_java_version || exit 1
    tb_run_quiet --help
fi
